{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "consoleName": "Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "swarmmind.api.server:create_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "SandBox",
      "type": "node-terminal",
      "request": "launch",
      "command": "bash -lc 'cd \"${workspaceFolder}\" && source .venv/bin/activate && exec .venv/bin/opensandbox-server'"
    },
    {
      "name": "User Test",
      "consoleName": "User Test",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/submit_task.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "--base-url",
        "http://127.0.0.1:8000",
        "--wait-for-service",
        "20",
        "--goal",
        "我想做一个近期关于黄金投资建议的PPT，内容需要包含近期的黄金价格走势分析、未来的价格预测以及投资建议。",
        "--poll"
      ]
    },
    {
      "name": "Submit Agent Backed Task",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/submit_task.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "--base-url",
        "http://127.0.0.1:8000",
        "--wait-for-service",
        "20",
        "--goal",
        "我想做一个近期关于黄金投资建议的PPT，内容需要包含近期的黄金价格走势分析、未来的价格预测以及投资建议。",
        "--preferred-strategy",
        "agent_backed",
        "--poll"
      ]
    },
    {
      "name": "Submit Agent Backed Handoff Task",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/submit_task.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "--base-url",
        "http://127.0.0.1:8000",
        "--wait-for-service",
        "20",
        "--goal",
        "做一个基于多agent产品的研究报告",
        "--preferred-strategy",
        "agent_backed",
        "--handoff-request",
        "prepare-implementation=researcher-default",
        "--poll"
      ]
    }
  ],
  "compounds": [
    {
      "name": "Server + Sandbox",
      "configurations": [
        "Server",
        "SandBox"
      ]
    },
    {
      "name": "Server + User Test",
      "configurations": [
        "Server",
        "User Test"
      ],
      "stopAll": true
    }
  ]
}