{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "consoleName": "Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "swarmmind.api.server:create_app",
        "--factory",
        "--host",
        "0.0.0.0",
        "--port",
        "50019"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "SWARMMIND_REPOSITORIES__REPLAY_BACKEND": "file",
        "SWARMMIND_REPOSITORIES__ARTIFACT_BACKEND": "file",
        "SWARMMIND_REPOSITORIES__FILE_BASE_PATH": "${workspaceFolder}/data"
      }
    },
    {
      "name": "SandBox",
      "type": "node-terminal",
      "request": "launch",
      "command": "bash -lc 'cd \"${workspaceFolder}\" && source .venv/bin/activate && exec .venv/bin/opensandbox-server'"
    },
    {
      "name": "User Test",
      "consoleName": "User Test",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/submit_task.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "--base-url",
        "http://127.0.0.1:8000",
        "--wait-for-service",
        "20",
        "--goal",
        "我想做一个近期关于黄金投资建议的PPT，内容需要包含近期的黄金价格走势分析、未来的价格预测以及投资建议。",
        // "做一个深度研究报告关于：以LLM为中心的认知架构（ReAct、AutoGPT）、多模态基础模型+工具调用、以及面向目标的强化学习智能体。请系统综述这些路径在泛化能力、样本效率、可解释性和安全性上的根本差异，并评估哪条路径更接近'通用智能体'的愿景。",
        "--poll"
      ]
    },
    {
      "name": "FlyReport Chat",
      "consoleName": "FlyReport Chat",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/fly_report_chat.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "生成农业局上周飞行周报"
      ]
    },
    {
      "name": "DataFetcher Fetch Test",
      "consoleName": "DataFetcher Fetch Test",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/test_data_fetcher_fetch.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "Task Show",
      "type": "node-terminal",
      "request": "launch",
      "command": "bash -lc 'cd \"${workspaceFolder}\" && exec ./front/task_show/start.sh'"
    }
  ],
  "compounds": [
    {
      "name": "Server + Sandbox + TaskShow",
      "configurations": [
        "Server",
        "SandBox",
        "Task Show"
      ],
      "stopAll": true
    }
  ]
}