{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server",
      "consoleName": "Server",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "swarmmind.api.server:create_app",
        "--factory",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "SWARMMIND_REPOSITORIES__REPLAY_BACKEND": "file",
        "SWARMMIND_REPOSITORIES__ARTIFACT_BACKEND": "file",
        "SWARMMIND_REPOSITORIES__FILE_BASE_PATH": "${workspaceFolder}/data"
      }
    },
    {
      "name": "SandBox",
      "type": "node-terminal",
      "request": "launch",
      "command": "bash -lc 'cd \"${workspaceFolder}\" && source .venv/bin/activate && exec .venv/bin/opensandbox-server'"
    },
    {
      "name": "User Test",
      "consoleName": "User Test",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/submit_task.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "args": [
        "--base-url",
        "http://127.0.0.1:8000",
        "--wait-for-service",
        "20",
        "--goal",
        "我想做一个近期关于黄金投资建议的PPT，内容需要包含近期的黄金价格走势分析、未来的价格预测以及投资建议。",
        "--poll"
      ]
    },
    {
      "name": "Task Show",
      "type": "node-terminal",
      "request": "launch",
      "command": "bash -lc 'cd \"${workspaceFolder}\" && exec ./front/task_show/start.sh'"
    }
  ],
  "compounds": [
    {
      "name": "Server + Sandbox + TaskShow",
      "configurations": [
        "Server",
        "SandBox",
        "Task Show"
      ],
      "stopAll": true
    }
  ]
}