<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title>{{ report.title }}</title>
  <style>
    @page { size: A4; margin: 2.0cm 2.0cm 2.5cm 2.0cm; }
    body { font-family: "Source Han Sans CN", "Noto Sans CJK SC", "PingFang SC", sans-serif; font-size: 11pt; color: #1a1a1a; line-height: 1.6; }
    h1 { font-size: 24pt; color: #003366; border-bottom: 3px solid #003366; padding-bottom: .3em; margin: 0 0 .5em; }
    h2 { font-size: 16pt; color: #003366; margin-top: 1.6em; }
    h3 { font-size: 12pt; color: #555; }
    .meta { background: #f0f4f8; padding: .5em .8em; border-left: 4px solid #003366; font-size: 10pt; color: #444; margin-bottom: 1.2em; }
    table { width: 100%; border-collapse: collapse; margin: .5em 0 1em; }
    th, td { border: 1px solid #b8c7d9; padding: 5pt 8pt; font-size: 10pt; }
    th { background: #003366; color: #fff; text-align: left; }
    tr:nth-child(even) td { background: #f7f9fc; }
    .footer { color: #888; font-size: 9pt; margin-top: 2em; border-top: 1px dashed #b8c7d9; padding-top: .5em; }
    .delta-up { color: #c00; font-weight: bold; }
    .delta-down { color: #080; font-weight: bold; }
  </style>
</head>
<body>
{% include "_body.html.j2" %}
</body>
</html>
