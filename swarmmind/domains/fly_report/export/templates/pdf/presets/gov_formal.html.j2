<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <title>{{ report.title }}</title>
  <style>
    @page { size: A4; margin: 2.5cm 2.5cm 3.0cm 2.5cm; @bottom-center { content: "第 " counter(page) " 页 / 共 " counter(pages) " 页"; font-size: 9pt; color: #666; } }
    body { font-family: "FangSong", "STSong", "Source Han Serif CN", serif; font-size: 12pt; color: #000; line-height: 1.8; }
    h1 { font-size: 22pt; text-align: center; margin: 0 0 1em; font-family: "SimHei", "Source Han Sans CN", sans-serif; }
    h2 { font-size: 14pt; font-family: "SimHei", "Source Han Sans CN", sans-serif; margin-top: 1.5em; }
    h3 { font-size: 12pt; }
    .meta { font-size: 11pt; margin-bottom: 1.2em; padding: .3em 0; border-bottom: 1px solid #000; }
    table { width: 100%; border-collapse: collapse; margin: .5em 0 1em; }
    th, td { border: 1px solid #000; padding: 5pt 8pt; font-size: 11pt; }
    th { background: #e8e8e8; text-align: center; font-family: "SimHei", "Source Han Sans CN", sans-serif; }
    .footer { font-size: 10pt; margin-top: 2em; padding-top: .5em; border-top: 1px solid #000; text-align: center; }
    .delta-up, .delta-down { color: #000; }
  </style>
</head>
<body>
{% include "_body.html.j2" %}
</body>
</html>
