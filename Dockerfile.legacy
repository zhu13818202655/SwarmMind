FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    SWARMMIND_PROJECT_ROOT=/app \
    PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple \
    PIP_TRUSTED_HOST=pypi.tuna.tsinghua.edu.cn

WORKDIR /app

RUN set -eux; \
    sed -i 's@deb.debian.org@mirrors.tuna.tsinghua.edu.cn@g; s@security.debian.org@mirrors.tuna.tsinghua.edu.cn@g' /etc/apt/sources.list.d/debian.sources; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        build-essential \
        curl \
        git \
        pandoc \
        fontconfig \
        fonts-noto-cjk \
        fonts-noto-cjk-extra \
        fonts-wqy-microhei \
        fonts-wqy-zenhei \
        fonts-arphic-uming \
        fonts-arphic-ukai; \
    fc-cache -fv; \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md requirements.txt ./

RUN set -eux; \
    python -m pip install --upgrade pip setuptools wheel; \
    python -m pip install -r requirements.txt

COPY swarmmind ./swarmmind
COPY configs ./configs
COPY alembic.ini ./
COPY alembic ./alembic
# Ship the FlyReport Text-to-SQL knowledge base outside /app/data so that
# mounting a volume at /app/data does not shadow it. Pair this with
# SWARMMIND_FLY_REPORT__TEXT2SQL__KNOWLEDGE_PATH=/app/knowledge/fly_report_text2sql
# in the deployment environment.
COPY data/fly_report_text2sql/knowledge ./knowledge/fly_report_text2sql

RUN set -eux; \
    python -m pip install --no-deps .

EXPOSE 8000

CMD ["sh", "-c", "uvicorn swarmmind.api.server:create_app --factory --host ${SWARMMIND_API__HOST:-0.0.0.0} --port ${SWARMMIND_API__PORT:-8000} --workers ${SWARMMIND_UVICORN_WORKERS:-4}"]